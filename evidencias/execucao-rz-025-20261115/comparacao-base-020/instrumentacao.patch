+#[cfg(feature = "comparacao-consultas-vazias")]
+const JANELA_COMPARACAO_TIQUES: u64 = 100;
+
+// Medição de diagnóstico por volta do terminal: consulta vazia é uma chamada
+// a receber() que retorna None; volta sem trabalho não retira IPC nem lê byte
+// serial/PS2. O comando medir-vazio inicia uma única janela; o resultado só é
+// emitido se a amostra terminar exatamente 100 tiques depois. Não mede CPU.
+#[cfg(feature = "comparacao-consultas-vazias")]
+struct MedicaoConsultasVazias {
+    ativa: bool,
+    concluida: bool,
+    inicio: u64,
+    consultas_ipc_vazias: u64,
+    voltas_sem_trabalho: u64,
+}
+
+#[cfg(feature = "comparacao-consultas-vazias")]
+impl MedicaoConsultasVazias {
+    const fn nova() -> Self {
+        Self {
+            ativa: false,
+            concluida: false,
+            inicio: 0,
+            consultas_ipc_vazias: 0,
+            voltas_sem_trabalho: 0,
+        }
+    }
+
+    fn armar(&mut self) {
+        if self.ativa || self.concluida {
+            imprimirln!("[medicao-vazia] FALHA_ESTADO");
+            return;
+        }
+        self.inicio = sistema::tiques();
+        self.consultas_ipc_vazias = 0;
+        self.voltas_sem_trabalho = 0;
+        self.ativa = true;
+        imprimirln!(
+            "\n[medicao-vazia] ARMADA revisao=0.2 janela_tiques={} inicio={}",
+            JANELA_COMPARACAO_TIQUES,
+            self.inicio
+        );
+    }
+
+    fn concluir_se_vencida(&mut self) {
+        if !self.ativa {
+            return;
+        }
+        let fim = sistema::tiques();
+        let decorrido = fim.wrapping_sub(self.inicio);
+        if decorrido < JANELA_COMPARACAO_TIQUES {
+            return;
+        }
+        self.ativa = false;
+        self.concluida = true;
+        if decorrido != JANELA_COMPARACAO_TIQUES {
+            imprimirln!(
+                "\n[medicao-vazia] FALHA_JANELA inicio={} fim={} decorrido={} esperado={}",
+                self.inicio,
+                fim,
+                decorrido,
+                JANELA_COMPARACAO_TIQUES
+            );
+            return;
+        }
+        imprimirln!(
+            "\n[medicao-vazia] RESULTADO revisao=0.2 janela_tiques={} inicio={} fim={} decorrido={} consultas_ipc_vazias={} voltas_sem_trabalho={}",
+            JANELA_COMPARACAO_TIQUES,
+            self.inicio,
+            fim,
+            decorrido,
+            self.consultas_ipc_vazias,
+            self.voltas_sem_trabalho
+        );
+    }
+}
