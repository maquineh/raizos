+fn executar_comparacao_vazia(
+    raiz: &Path,
+    arquivo_serial: File,
+    arquivo_erros: File,
+) -> Resultado<ResultadoComparacaoVazia> {
+    conferir(
+        raiz.join("saida/raiz-os.img").is_file()
+            && raiz.join("saida/esp/EFI/BOOT/BOOTX64.EFI").is_file(),
+        "Imagem opt-in ausente; compile primeiro com `cargo raiz compilar --comparacao-vazia`",
+    )?;
+    let reserva_porta = UdpSocket::bind("127.0.0.1:17777").map_err(|e| {
+        format!("UDP 127.0.0.1:17777 indisponível; encerre outra VM antes do teste: {e}")
+    })?;
+    let mut comando = preparar_qemu(raiz, false, true)?;
+    comando
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped());
+    drop(reserva_porta);
+    let mut processo = ProcessoQemu(comando.spawn()?);
+    let mut entrada = processo
+        .0
+        .stdin
+        .take()
+        .ok_or("stdin do emulador indisponível")?;
+    let saida = processo
+        .0
+        .stdout
+        .take()
+        .ok_or("stdout do emulador indisponível")?;
+    let erros = processo
+        .0
+        .stderr
+        .take()
+        .ok_or("stderr do emulador indisponível")?;
+    let (emissor, receptor) = mpsc::channel();
+    let leitores = [
+        leitor_saida(saida, true, emissor.clone()),
+        leitor_saida(erros, false, emissor),
+    ];
+    let mut captura = Captura {
+        eventos: receptor,
+        serial: Vec::new(),
+        erros: Vec::new(),
+        arquivo_serial,
+        arquivo_erros,
+    };
+    let resultado = (|| -> Resultado<ResultadoComparacaoVazia> {
+        captura.aguardar_linha(
+            &mut processo,
+            "[teste] TERMINAL_PRONTO",
+            0,
+            Duration::from_secs(30),
+        )?;
+        captura.aguardar_condicao(
+            &mut processo,
+            "[rede] SERVICO_PRONTO CPL=3",
+            0,
+            Duration::from_secs(15),
+            |bytes| serial_contem_prefixo_linha(bytes, "[rede] SERVICO_PRONTO CPL=3"),
+        )?;
+        captura.aguardar_condicao(
+            &mut processo,
+            "[supervisor] SERVICO_PRONTO CPL=3",
+            0,
+            Duration::from_secs(15),
+            |bytes| serial_contem_prefixo_linha(bytes, "[supervisor] SERVICO_PRONTO CPL=3"),
+        )?;
+        conferir(
+            captura
+                .serial
+                .windows(b"EXIT_BOOT_SERVICES_OK".len())
+                .any(|w| w == b"EXIT_BOOT_SERVICES_OK"),
+            "O boot não mostrou EXIT_BOOT_SERVICES_OK",
+        )?;
+        captura.drenar()?;
+        let inicio_comando = captura.serial.len();
+        entrada.write_all(b"medir-vazio\n")?;
+        entrada.flush()?;
+        captura.aguardar_condicao(
+            &mut processo,
+            "[medicao-vazia] ARMADA completa",
+            inicio_comando,
+            Duration::from_secs(15),
+            |bytes| {
+                serial_contem_prefixo_linha(bytes, "[medicao-vazia] ARMADA")
+                    || serial_contem_prefixo_linha(bytes, "[medicao-vazia] FALHA")
+            },
+        )?;
+        captura.aguardar_condicao(
+            &mut processo,
+            "[medicao-vazia] RESULTADO/FALHA_JANELA completa",
+            inicio_comando,
+            Duration::from_secs(15),
+            |bytes| {
+                serial_contem_prefixo_linha(bytes, "[medicao-vazia] RESULTADO")
+                    || serial_contem_prefixo_linha(bytes, "[medicao-vazia] FALHA")
+                    || serial_contem_prefixo_linha(bytes, "[microkernel] FALHA_NUCLEO")
+                    || serial_contem_prefixo_linha(bytes, "[microkernel] SERVICO_FALHOU")
+                    || serial_contem_prefixo_linha(bytes, "[microkernel] SERVICO_FINALIZADO")
+            },
+        )?;
+        captura.drenar()?;
+        validar_log_comparacao_vazia(&captura.serial)
+    })();
+    drop(entrada);
+    processo.encerrar();
+    let mut erro_finalizacao = None;
+    for leitor in leitores {
+        if leitor.join().is_err() {
+            erro_finalizacao = Some("Falha na thread de captura do emulador".to_owned());
+        }
+    }
+    if let Err(erro) = captura.drenar() {
+        erro_finalizacao = Some(erro.to_string());
+    }
+    captura.arquivo_serial.flush()?;
+    captura.arquivo_erros.flush()?;
+    match resultado {
+        Err(erro) => Err(erro),
+        Ok(medicao) => match erro_finalizacao {
+            Some(erro) => Err(erro.into()),
+            None => Ok(medicao),
+        },
+    }
+}
+
+fn serial_linhas_completas(bytes: &[u8]) -> Result<Vec<&str>, String> {
+    let texto = std::str::from_utf8(bytes).map_err(|erro| format!("Serial não UTF-8: {erro}"))?;
+    let mut linhas = Vec::new();
+    for registro in texto.split_inclusive('\n') {
+        let Some(linha) = registro.strip_suffix('\n') else {
+            if registro.starts_with("[medicao-vazia]") {
+                return Err("Log terminou com marcador de medição incompleto".into());
+            }
+            continue;
+        };
+        linhas.push(linha.strip_suffix('\r').unwrap_or(linha));
+    }
+    Ok(linhas)
+}
+
+fn serial_contem_prefixo_linha(bytes: &[u8], prefixo: &str) -> bool {
+    serial_linhas_completas(bytes)
+        .is_ok_and(|linhas| linhas.iter().any(|linha| linha.starts_with(prefixo)))
+}
+
+fn validar_log_comparacao_vazia(bytes: &[u8]) -> Resultado<ResultadoComparacaoVazia> {
+    let linhas = serial_linhas_completas(bytes).map_err(|erro| format!("{erro}"))?;
+    let mut armadas = Vec::new();
+    let mut resultados = Vec::new();
+    for linha in &linhas {
+        if linha.starts_with("[medicao-vazia]") {
+            if linha.starts_with("[medicao-vazia] FALHA") {
+                return Err(format!("A fixture recusou a janela: {linha}").into());
+            } else if linha.starts_with("[medicao-vazia] ARMADA") {
+                armadas.push(*linha);
+            } else if linha.starts_with("[medicao-vazia] RESULTADO") {
+                resultados.push(*linha);
+            } else {
+                return Err(format!("Marcador desconhecido da medição: {linha}").into());
+            }
+        }
+        if linha.contains("SERVICO_FALHOU") || linha.contains("panic") {
+            return Err(format!("Falha de serviço/kernel durante a medição: {linha}").into());
+        }
+    }
+    if armadas.len() != 1 || resultados.len() != 1 {
+        return Err(format!(
+            "Esperados ARMADA e RESULTADO únicos; recebidos {} e {}",
+            armadas.len(),
+            resultados.len()
+        )
+        .into());
+    }
+    let (inicio_armada, janela_armada) = parse_linha_medicao_armada(armadas[0])?;
+    let medicao = parse_linha_medicao_resultado(resultados[0])?;
+    if janela_armada != 100
+        || medicao.inicio != inicio_armada
+        || medicao.decorrido != 100
+        || medicao.fim.wrapping_sub(medicao.inicio) != 100
+    {
+        return Err("Janela, tick inicial ou duração divergem da ARMADA de 100 tiques".into());
+    }
+    let pos_armada = linhas
+        .iter()
+        .position(|linha| *linha == armadas[0])
+        .unwrap();
+    let pos_resultado = linhas
+        .iter()
+        .position(|linha| *linha == resultados[0])
+        .unwrap();
+    if pos_resultado <= pos_armada {
+        return Err("RESULTADO precede ARMADA".into());
+    }
+    Ok(medicao)
+}
+
+fn parse_linha_medicao_armada(linha: &str) -> Resultado<(u64, u64)> {
+    let tokens: Vec<&str> = linha.split_whitespace().collect();
+    if tokens.len() != 5 || tokens[0] != "[medicao-vazia]" || tokens[1] != "ARMADA" {
+        return Err("Marcador ARMADA malformado".into());
+    }
+    let revisao = campo_unico_medicao(linha, "revisao=")?;
+    let janela = campo_decimal_medicao(linha, "janela_tiques=")?;
+    let inicio = campo_decimal_medicao(linha, "inicio=")?;
+    if revisao != "0.2" {
+        return Err("ARMADA não identifica a revisão 0.2".into());
+    }
+    Ok((inicio, janela))
+}
+
+fn parse_linha_medicao_resultado(linha: &str) -> Resultado<ResultadoComparacaoVazia> {
+    let tokens: Vec<&str> = linha.split_whitespace().collect();
+    if tokens.len() != 9 || tokens[0] != "[medicao-vazia]" || tokens[1] != "RESULTADO" {
+        return Err("Marcador RESULTADO malformado".into());
+    }
+    let revisao = campo_unico_medicao(linha, "revisao=")?;
+    let janela = campo_decimal_medicao(linha, "janela_tiques=")?;
+    if revisao != "0.2" || janela != 100 {
+        return Err("RESULTADO não corresponde à janela base 0.2 de 100 tiques".into());
+    }
+    Ok(ResultadoComparacaoVazia {
+        inicio: campo_decimal_medicao(linha, "inicio=")?,
+        fim: campo_decimal_medicao(linha, "fim=")?,
+        decorrido: campo_decimal_medicao(linha, "decorrido=")?,
+        consultas_ipc_vazias: campo_decimal_medicao(linha, "consultas_ipc_vazias=")?,
+        voltas_sem_trabalho: campo_decimal_medicao(linha, "voltas_sem_trabalho=")?,
+    })
+}
+
+fn campo_unico_medicao<'a>(linha: &'a str, nome: &str) -> Resultado<&'a str> {
+    let mut valores = linha
+        .split_whitespace()
+        .filter_map(|campo| campo.strip_prefix(nome));
+    let valor = valores
+        .next()
+        .ok_or_else(|| format!("Campo ausente: {nome}"))?;
+    if valores.next().is_some() {
+        return Err(format!("Campo duplicado: {nome}").into());
+    }
+    Ok(valor)
+}
+
+fn campo_decimal_medicao(linha: &str, nome: &str) -> Resultado<u64> {
+    let valor = campo_unico_medicao(linha, nome)?;
+    if valor.is_empty() || !valor.bytes().all(|byte| byte.is_ascii_digit()) {
+        return Err(format!("Campo decimal malformado: {nome}{valor}").into());
+    }
+    Ok(valor.parse()?)
+}
